[Unit]
Description=Multivac — orquestador y bus
# graphical-session en vez de default.target: uwsm lo activa DESPUÉS de exportar
# el entorno de Hyprland. Enganchado a default.target, el servicio arrancaría sin
# HYPRLAND_INSTANCE_SIGNATURE y no podría abrir aplicaciones.
After=graphical-session.target
PartOf=graphical-session.target
# Arrancar el core levanta los otros dos; pararlo (PartOf en ellos) los para.
# Así "systemctl --user start multivac-core" es el único comando necesario.
Wants=multivac-ears.service multivac-voice.service
# Ollama es un servicio del SISTEMA: una unidad de usuario no puede declararlo
# como dependencia (systemd falla con "Unit ollama.service not found"). Ya
# arranca solo con el equipo, y si no estuviera, el agente devuelve un error
# controlado en vez de caerse.

[Service]
Type=simple
# La ruta del proyecto NO está escrita aquí: sale de MULTIVAC_RAIZ, que
# scripts/setup.sh deja en ~/.config/multivac/entorno con la ruta real del
# clon. Así estas unidades sirven tal cual, esté el repositorio donde esté.
EnvironmentFile=%h/.config/multivac/entorno
# systemd no expande variables en el ejecutable de ExecStart (ha de ser una
# ruta absoluta literal), de ahí el `sh -c`. El `exec` sustituye la shell por
# Python: no queda proceso intermedio, y las señales y el código de salida
# son los del servicio de verdad. El WorkingDirectory sobraba: la config se
# localiza desde el propio paquete, no desde el directorio actual.
ExecStart=/bin/sh -c 'exec "$MULTIVAC_RAIZ/.venv/bin/python" -m multivac.core'
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
